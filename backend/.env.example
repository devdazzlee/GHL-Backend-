# Backend environment: the URL settings. Copy the values you need into .env.
# Secrets (DATABASE_URL, JWT_SECRET, ADMIN_API_KEYS, API keys) are not listed here.

# Frontends. All optional: the production addresses below are built in
# (backend/src/config/defaults.js), so set these only to add or override.
#
# Where cache refreshes are sent after content changes (the site renderer).
# SITE_FRONTEND_URL=https://site.peakwa.com
#
# Browser origins trusted for CORS and for the Google-connect return. Built in:
# https://dashboard.peakwa.com, https://site.peakwa.com and local dev
# (http://localhost:5173, http://127.0.0.1:5173, http://localhost:3000).
# DASHBOARD_URL=https://dashboard.peakwa.com
# SITE_URL=https://site.peakwa.com
# CORS_ORIGINS=https://another-origin.example,https://one-more.example
#
# Live client custom domains are trusted automatically (no setting needed).

# Frontend server public IP (custom-domain DNS checks). Built in: 169.58.4.58.
# FRONTEND_PUBLIC_IP=169.58.4.58

# On startup the backend logs "server_listen" with the full allowedOrigins list.
