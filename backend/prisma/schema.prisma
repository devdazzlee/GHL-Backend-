// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
}

enum LocationStatus {
  ACTIVE
  INACTIVE
}

enum PostType {
  UPDATE
  OFFER
  EVENT
}

enum PostStatus {
  DRAFT
  SCHEDULED
  POSTED
  PENDING
  PUBLISHED
  REJECTED
  FAILED
}

/// Per-location switch for mirroring posts to Facebook/Instagram through GHL
/// Social Planner. DRAFT creates GHL drafts only (nothing publishes); LIVE schedules.
enum SocialPostingMode {
  OFF
  DRAFT
  LIVE
}

enum SocialPostStatus {
  SENT
  FAILED
  SKIPPED
}

enum SiteStatus {
  PENDING
  ACTIVE
  INACTIVE
}

model Business {
  id            String         @id @default(cuid())
  name          String
  category      String?
  ghlAccountId  String         @unique
  status        BusinessStatus @default(ACTIVE)
  createdAt     DateTime       @default(now())
  locations     Location[]
}

model Location {
  id                 String           @id @default(cuid())
  businessId         String
  business           Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  ghlLocationId      String           @unique
  googleLocationId   String?
  googleAccountId    String?
  city               String?
  timezone           String           @default("UTC")
  /// Max word length for generated posts (50-300). Default 80 matches the
  /// original hardcoded limit used in the content generator prompt.
  maxPostLength      Int              @default(80)
  status             LocationStatus   @default(ACTIVE)
  requiresApproval   Boolean          @default(false)
  ghlLastPostDateFieldId String?
  ghlPostStatusFieldId   String?
  ghlApiKey              String?
  /// OAuth tokens for Google Business Profile (encrypt at rest in production)
  googleAccessToken  String?
  googleRefreshToken String?
  googleTokenExpiresAt DateTime?
  /// Per-location OFFER post config. When couponCode is null, no coupon is sent
  /// (it is optional in Google's Local Posts API) so we never fabricate a code.
  offerCouponCode    String?
  offerTerms         String?
  offerRedeemUrl     String?
  /// Towns/cities in this location's service area. Posts pick a random one per
  /// generation instead of always using the location's home city. Empty/unset
  /// falls back to the home city.
  serviceAreaTowns   String[]         @default([])
  /// GHL Social Planner mirroring. Every location starts OFF.
  socialPostingMode  SocialPostingMode @default(OFF)
  /// GHL user the social posts are created as (Create Post requires userId).
  ghlSocialUserId    String?
  /// Facebook Page + Instagram accounts only: [{ id, platform, type, name }].
  /// The GBP "location" account is never stored — we post to Google directly.
  ghlSocialAccounts  Json             @default("[]")
  ghlSocialAccountsSyncedAt DateTime?
  /// Per-platform switches under socialPostingMode (the master switch).
  /// Read when each post is made; posts already scheduled in GHL are unaffected.
  socialFacebookEnabled  Boolean @default(true)
  socialInstagramEnabled Boolean @default(true)
  createdAt          DateTime         @default(now())
  posts              Post[]
  media              Media[]
  auditLogs          AuditLog[]
  schedule           LocationSchedule?
  leadSites          GeneratedSite[]  @relation("SiteLeadLocation")

  @@index([businessId])
}

model LocationSchedule {
  id            String   @id @default(cuid())
  locationId    String   @unique
  location      Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  postsPerWeek  Int      @default(3)
  postDays      String[] @default(["Monday", "Wednesday", "Friday"])
  postTime      String   @default("09:00")
  postTypes     String[] @default(["UPDATE", "OFFER", "VIDEO"])
  /// Per weekday: { "Monday": "UPDATE", "Tuesday": "OFFER", ... }
  postDayTypes  Json     @default("{}")
  /// Per weekday: { "Monday": "09:00", "Tuesday": "10:30", ... }
  postDayTimes  Json     @default("{}")
  timezone      String   @default("America/New_York")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Media {
  id         String   @id @default(cuid())
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  postType   PostType
  url        String
  createdAt  DateTime @default(now())

  @@index([locationId, postType])
}

model Post {
  id          String     @id @default(cuid())
  locationId  String
  location    Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  type        PostType
  content     String     @db.Text
  mediaUrl    String?
  scheduledAt DateTime?
  postedAt    DateTime?
  status      PostStatus @default(DRAFT)
  platform    String     @default("google")
  /// Per-post opt-out of the Facebook/Instagram mirror.
  skipSocial  Boolean    @default(false)
  createdAt   DateTime   @default(now())

  @@index([locationId])
}

/// One row per social mirror attempt. sourceType is "GBP_POST" today; blogs and
/// reviews will reuse it with their own sourceType. The unique key stops a
/// retry or re-approval from posting the same source twice.
model SocialPost {
  id         String            @id @default(cuid())
  locationId String
  sourceType String
  sourceId   String
  mode       SocialPostingMode
  accountIds String[]          @default([])
  ghlPostId  String?
  status     SocialPostStatus
  error      String?
  /// LIVE only: the scheduleDate sent to GHL. The status checker looks for
  /// GHL-side publish failures once this has passed.
  scheduledFor  DateTime?
  lastCheckedAt DateTime?
  /// Set when the failure alert is sent, so each post alerts at most once.
  alertedAt     DateTime?
  /// Per-platform outcome: { facebook: { accountId, status, error?, ghlChildPostId?, at }, instagram: {...} }
  /// status is SENT | FAILED | DISABLED. Null on rows from before this field.
  platformResults Json?
  createdAt  DateTime          @default(now())

  @@unique([sourceType, sourceId])
  @@index([locationId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  details    Json?
  createdAt  DateTime @default(now())

  @@index([locationId])
  @@index([createdAt])
}

model Template {
  id           String          @id @default(cuid())
  name         String
  industry     String
  slug         String          @unique
  description  String?
  previewImage String?
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sites        GeneratedSite[]
}

model IndustrySchema {
  id                 String   @id @default(cuid())
  industry           String   @unique
  displayName        String
  systemPrompt       String
  homePageSchema     String
  aboutPageSchema    String
  servicesPageSchema String
  contactPageSchema  String
  locationPageSchema String
  blogPageSchema     String
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model GeneratedSite {
  id              String         @id @default(cuid())
  businessName    String
  industry        String
  city            String
  state           String         @default("NJ")
  phone           String?
  email           String?
  description     String?
  slug            String         @unique
  templateId      String
  template        Template       @relation(fields: [templateId], references: [id])
  homeContent     String?
  aboutContent    String?
  servicesContent String?
  contactContent  String?
  blogContent     String?
  status          SiteStatus     @default(PENDING)
  primaryColor    String         @default("#1F2937")
  secondaryColor  String         @default("#F3F4F6")
  accentColor     String         @default("#6366F1")
  heroStyle       String         @default("dark")
  fontStyle       String         @default("modern")
  designVariant   Int            @default(1)
  yearsInBusiness String?
  customersServed String?
  projectsCompleted String?
  address         String?
  facebookUrl     String?
  instagramUrl    String?
  websiteUrl      String?
  logoUrl         String?
  /// Search engines may index this site only when true. Null/false = noindex
  /// (the default for every generated site, including demo businesses).
  searchIndexable Boolean?
  /// GHL location (Location.id) that receives this site's contact-form leads.
  /// Null = not mapped: leads are kept in our database and flagged, never sent elsewhere.
  leadLocationId  String?
  leadLocation    Location?      @relation("SiteLeadLocation", fields: [leadLocationId], references: [id], onDelete: SetNull)
  /// Whole blog on/off. Null = on (every site has shown its blog since creation); false hides
  /// the blog pages, nav/footer links and sitemap entries, and stops automatic posts.
  blogEnabled     Boolean?
  /// Automatic posts (off unless true): weekdays (0=Sun..6=Sat, comma separated, 2-3 days),
  /// local hour 0-23, IANA time zone.
  blogAutoEnabled Boolean?
  blogAutoDays    String?
  blogAutoHour    Int?
  blogTimezone    String?
  /// Page images, picked once and then kept until someone changes them in the dashboard.
  /// JSON { hero, about, services: { [serviceTitle]: entry }, blog: [entry] }, entry = { url, source }
  imagesContent   String?        @db.Text
  /// Hand edits to page text, re-applied after regeneration and undoable.
  /// JSON { [page]: { [path]: { value, original, anchor, editedAt } } }
  contentEdits    String?        @db.Text
  /// The site's own domain, e.g. "www.acmehvac.com" (lowercase host only). Null = the site
  /// lives at site.peakwa.com/{slug} only. One site per domain is enforced by the domain
  /// service (a unique constraint here would make the deploy's `prisma db push` stop).
  customDomain    String?
  /// When the domain was verified: its DNS points at the frontend server and HTTPS answers for
  /// this site. Null = not live yet, so links, canonical URLs and redirects stay on site.peakwa.com.
  customDomainVerifiedAt DateTime?
  locationPages   LocationPage[]
  keywordPages    KeywordPage[]
  blogPosts       BlogPost[]
  redirects       SiteRedirect[]
  contactSubmissions ContactSubmission[]
  servicePages    ServicePage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([customDomain])
}

model ServicePage {
  id           String        @id @default(cuid())
  siteId       String
  site         GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  serviceSlug  String
  serviceTitle String
  content      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([siteId, serviceSlug])
}

model LocationPage {
  id        String        @id @default(cuid())
  siteId    String
  site      GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  city      String
  county    String
  state     String        @default("NJ")
  slug      String
  content   String?
  imageUrl  String?
  createdAt DateTime      @default(now())
  keywordPages KeywordPage[]

  @@unique([siteId, slug])
}

/// On-request keyword + city landing pages (never part of the automatic build).
/// Generated as DRAFT, previewed, then published from the dashboard.
model KeywordPage {
  id             String        @id @default(cuid())
  siteId         String
  site           GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  locationPageId String
  locationPage   LocationPage  @relation(fields: [locationPageId], references: [id], onDelete: Cascade)
  keyword        String
  /// URL segment under /{siteSlug}/k/{slug}
  slug           String
  /// DRAFT | PUBLISHED
  status         String        @default("DRAFT")
  /// Generated JSON content
  content        String        @db.Text
  /// Highest text overlap (0-1) with any other page on the site when created
  maxSimilarity  Float?
  similarTo      String?
  createdAt      DateTime      @default(now())
  publishedAt    DateTime?

  @@unique([siteId, slug])
  @@index([siteId])
  @@index([locationPageId])
}

model ContactSubmission {
  id        String        @id @default(cuid())
  siteId    String
  site      GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  message   String
  /// Delivery to GHL: SENT | HELD_NO_LOCATION | HELD_NO_KEY | FAILED | SKIPPED_MOCK
  ghlStatus     String?
  ghlLocationId String?
  ghlContactId  String?
  ghlError      String?
  createdAt DateTime      @default(now())

  @@index([siteId])
  @@index([createdAt])
}

/// Blog posts managed per site. A site's original generated posts (GeneratedSite.blogContent)
/// are copied in the first time its blog is managed; from then on this table is the source.
model BlogPost {
  id             String        @id @default(cuid())
  siteId         String
  site           GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  /// URL segment under /{siteSlug}/blog/{slug}
  slug           String
  title          String
  /// Topic the post was written about (its first title). Never changed by edits, so topic
  /// de-duplication still sees it after someone retitles the post.
  topic          String?
  excerpt        String?       @db.Text
  /// Markdown-style body: ## / ### headings, paragraphs, "- " lists, [text](url) links, ![alt](url) images
  body           String        @db.Text
  /// JSON [{ question, answer }]
  faqs           String?       @db.Text
  /// JSON [{ label, path }]: "Explore more" links to the site's own pages
  links          String?       @db.Text
  imageUrl       String?
  category       String?
  seoTitle       String?
  seoDescription String?
  /// DRAFT | PUBLISHED
  status         String        @default("DRAFT")
  /// IMPORTED | MANUAL | AUTO
  source         String
  /// Position in the old blogContent posts (old /blog/{n} URLs redirect here)
  legacyIndex    Int?
  /// Local date (YYYY-MM-DD) of the scheduled run that wrote it; one automatic post per slot
  autoSlot       String?
  /// Last edit made in the dashboard
  editedAt       DateTime?
  publishedAt    DateTime?
  /// Soft delete: hidden everywhere, kept so its topic is never written again
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([siteId, slug])
  @@unique([siteId, autoSlot])
  @@index([siteId, status])
}

/// Old site URLs. /{fromSlug}/... answers 301 to the same path under the site's current slug.
/// Points at the site (not a slug), so repeated renames all lead to the current address.
model SiteRedirect {
  id        String        @id @default(cuid())
  fromSlug  String        @unique
  siteId    String
  site      GeneratedSite @relation(fields: [siteId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([siteId])
}
